{
    "$schema": "./node_modules/oxlint/configuration_schema.json",
    "extends": ["../node_modules/@gorgias/config/oxlint-react.json"],
    "jsPlugins": ["./node_modules/@gorgias/oxlint-custom-rules/index.mjs"],
    "overrides": [
        {
            "files": ["vitest.config.ts", "jest.config.ts", "oxfmt.config.ts"],
            "rules": {
                "import/no-default-export": "off"
            }
        }
    ],
    "rules": {
        "custom-rules/no-axiom-mock": "error",
        "custom-rules/no-sdk-mock": "warn",
        "custom-rules/no-generic-duration-wrapper": "error",
        "custom-rules/prefer-duration-for-timing": "error",
        "oxc/no-barrel-file": ["error", { "threshold": 300 }],
        "import/consistent-type-specifier-style": ["error", "prefer-top-level"],
        "sort-imports": [
            "error",
            { "ignoreCase": true, "ignoreDeclarationSort": true }
        ]
    }
}
