{
    "name": "@repo/billing",
    "version": "1.0.0",
    "description": "Billing types, constants, and utilities",
    "private": true,
    "exports": {
        ".": "./src/index.ts",
        "./fixtures": "./src/fixtures.ts"
    },
    "scripts": {
        "format:check": "oxfmt --check .",
        "format:fix": "oxfmt --write .",
        "lint": "oxlint --quiet",
        "lint:unused": "knip --directory ../.. --workspace @repo/billing --no-progress",
        "test": "vitest run --configLoader=runner --passWithNoTests",
        "test:ci:cover": "NODE_OPTIONS=\"--max-old-space-size=4096\" vitest run --maxWorkers=2 --configLoader=runner --coverage --passWithNoTests --silent=true",
        "test:watch": "vitest watch --configLoader=runner",
        "typecheck": "tsc -p ./tsconfig.json --noEmit true"
    },
    "peerDependencies": {
        "@gorgias/helpdesk-queries": "catalog:rest-api-sdk",
        "@repo/feature-flags": "workspace:*",
        "@repo/logging": "workspace:*",
        "@stripe/react-stripe-js": "^2.8.0",
        "@tanstack/react-query": "catalog:rest-api-sdk",
        "immutable": "3.8.3",
        "moment": "catalog:moment",
        "react": "catalog:react",
        "react-dom": "catalog:react",
        "react-router-dom": "catalog:react-router",
        "reactstrap": "8.9.0"
    },
    "devDependencies": {
        "@gorgias/helpdesk-mocks": "catalog:rest-api-sdk",
        "@gorgias/helpdesk-queries": "catalog:rest-api-sdk",
        "@gorgias/helpdesk-types": "catalog:rest-api-sdk",
        "@repo/config": "workspace:*",
        "@repo/feature-flags": "workspace:*",
        "@repo/logging": "workspace:*",
        "@repo/testing": "workspace:*",
        "@stripe/react-stripe-js": "^2.8.0",
        "@stripe/stripe-js": "^4.5.0",
        "@tanstack/react-query": "catalog:rest-api-sdk",
        "@testing-library/jest-dom": "catalog:test",
        "@testing-library/react": "catalog:test",
        "@types/jest": "catalog:test",
        "@types/react": "catalog:react",
        "@types/react-dom": "catalog:react",
        "@types/react-router": "catalog:react-router",
        "@types/react-router-dom": "catalog:react-router",
        "@vitest/coverage-v8": "catalog:test",
        "immutable": "3.8.3",
        "moment": "catalog:moment",
        "msw": "catalog:test",
        "oxlint": "catalog:oxlint",
        "react": "catalog:react",
        "react-dom": "catalog:react",
        "react-router-dom": "catalog:react-router",
        "reactstrap": "8.9.0",
        "typescript": "catalog:typescript",
        "vitest": "catalog:test",
        "oxfmt": "catalog:formatter"
    }
}
