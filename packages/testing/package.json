{
    "name": "@repo/testing",
    "version": "1.0.0",
    "description": "Non domain specific testing utilities for the monorepo",
    "private": true,
    "exports": {
        ".": "./src/index.ts",
        "./vitest": "./src/vitest/index.ts"
    },
    "scripts": {
        "format:check": "oxfmt --check .",
        "format:fix": "oxfmt --write .",
        "lint": "oxlint --quiet",
        "lint:unused": "knip --directory ../.. --workspace @repo/testing --no-progress",
        "typecheck": "tsgo -p ./tsconfig.json --noEmit true",
        "test": "vitest run --configLoader=runner",
        "test:ci:cover": "TZ=UTC LC_ALL=\"en_US.UTF-8\" NODE_OPTIONS=\"--max-old-space-size=4096\" vitest run --maxWorkers=2 --configLoader=runner --coverage --silent=true"
    },
    "peerDependencies": {
        "@gorgias/axiom": "catalog:axiom",
        "@tanstack/react-query": "catalog:rest-api-sdk",
        "@testing-library/dom": "catalog:test",
        "@testing-library/react": "catalog:test",
        "@testing-library/user-event": "catalog:test",
        "@types/react-redux": "catalog:redux",
        "@types/redux-mock-store": "catalog:redux",
        "@types/redux-thunk": "catalog:redux",
        "dnd-core": "catalog:react-dnd",
        "react": "catalog:react",
        "react-dnd": "catalog:react-dnd",
        "react-dnd-html5-backend": "catalog:react-dnd",
        "react-dom": "catalog:react",
        "react-redux": "catalog:redux",
        "react-router-dom": "catalog:react-router",
        "redux": "catalog:redux",
        "redux-mock-store": "catalog:redux",
        "redux-thunk": "catalog:redux"
    },
    "devDependencies": {
        "@gorgias/axiom": "catalog:axiom",
        "@repo/config": "workspace:*",
        "@tanstack/react-query": "catalog:rest-api-sdk",
        "@testing-library/dom": "catalog:test",
        "@testing-library/react": "catalog:test",
        "@testing-library/user-event": "catalog:test",
        "@types/jest": "catalog:test",
        "@types/react": "catalog:react",
        "@types/react-dom": "catalog:react",
        "@types/react-redux": "catalog:redux",
        "@types/react-router-dom": "catalog:react-router",
        "@types/redux-mock-store": "catalog:redux",
        "@types/redux-thunk": "catalog:redux",
        "@vitest/coverage-v8": "catalog:test",
        "dnd-core": "catalog:react-dnd",
        "oxfmt": "catalog:formatter",
        "oxlint": "catalog:oxlint",
        "react": "catalog:react",
        "react-dnd": "catalog:react-dnd",
        "react-dnd-html5-backend": "catalog:react-dnd",
        "react-dom": "catalog:react",
        "react-redux": "catalog:redux",
        "react-router-dom": "catalog:react-router",
        "redux": "catalog:redux",
        "redux-mock-store": "catalog:redux",
        "redux-thunk": "catalog:redux",
        "typescript": "catalog:typescript",
        "vitest": "catalog:test"
    }
}
