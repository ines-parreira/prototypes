{
    "name": "@repo/search",
    "version": "1.0.0",
    "description": "Shared spotlight search UI",
    "private": true,
    "exports": {
        ".": "./src/index.ts"
    },
    "scripts": {
        "format:check": "oxfmt --check .",
        "format:fix": "oxfmt --write .",
        "lint": "oxlint --quiet",
        "lint:unused": "knip --directory ../.. --workspace @repo/search --no-progress",
        "test": "vitest run --configLoader=runner",
        "test:ci:cover": "NODE_OPTIONS=\"--max-old-space-size=4096\" vitest run --maxWorkers=2 --configLoader=runner --coverage --silent=true",
        "test:watch": "vitest watch --configLoader=runner",
        "typecheck": "tsgo -p ./tsconfig.json --noEmit true"
    },
    "peerDependencies": {
        "@gorgias/axiom": "catalog:axiom",
        "@gorgias/helpdesk-client": "catalog:rest-api-sdk",
        "@gorgias/helpdesk-queries": "catalog:rest-api-sdk",
        "@repo/browser-storage": "workspace:*",
        "@repo/config": "workspace:*",
        "@gorgias/toolkit-react": "catalog:toolkit",
        "@repo/routing": "workspace:*",
        "@repo/utils": "workspace:*",
        "@tanstack/react-query": "catalog:rest-api-sdk",
        "lodash": "catalog:lodash",
        "react": "catalog:react",
        "react-dom": "catalog:react",
        "react-router-dom": "catalog:react-router",
        "@gorgias/toolkit": "catalog:toolkit"
    },
    "devDependencies": {
        "@gorgias/axiom": "catalog:axiom",
        "@gorgias/helpdesk-client": "catalog:rest-api-sdk",
        "@gorgias/helpdesk-mocks": "catalog:rest-api-sdk",
        "@gorgias/helpdesk-queries": "catalog:rest-api-sdk",
        "@repo/browser-storage": "workspace:*",
        "@repo/config": "workspace:*",
        "@gorgias/toolkit-react": "catalog:toolkit",
        "@repo/routing": "workspace:*",
        "@repo/testing": "workspace:*",
        "@repo/utils": "workspace:*",
        "@tanstack/react-query": "catalog:rest-api-sdk",
        "@testing-library/dom": "catalog:test",
        "@testing-library/jest-dom": "catalog:test",
        "@testing-library/react": "catalog:test",
        "@testing-library/user-event": "catalog:test",
        "@types/lodash": "catalog:lodash",
        "@types/react": "catalog:react",
        "@types/react-dom": "catalog:react",
        "@types/react-router-dom": "catalog:react-router",
        "@vitest/coverage-v8": "catalog:test",
        "lodash": "catalog:lodash",
        "msw": "catalog:test",
        "oxfmt": "catalog:formatter",
        "oxlint": "catalog:oxlint",
        "react": "catalog:react",
        "react-dom": "catalog:react",
        "react-router-dom": "catalog:react-router",
        "typescript": "catalog:typescript",
        "vitest": "catalog:test",
        "@gorgias/toolkit": "catalog:toolkit"
    }
}
