{
    "name": "@repo/agent-status",
    "version": "1.0.0",
    "description": "Agent status types, utilities, and helpers",
    "private": true,
    "exports": {
        ".": "./src/index.ts"
    },
    "scripts": {
        "format:check": "oxfmt --check .",
        "format:fix": "oxfmt --write .",
        "lint": "oxlint --quiet",
        "lint:unused": "knip --directory ../.. --workspace @repo/agent-status --no-progress",
        "test": "vitest run --configLoader=runner --passWithNoTests",
        "test:ci:cover": "NODE_OPTIONS=\"--max-old-space-size=4096\" vitest run --maxWorkers=2 --configLoader=runner --coverage --passWithNoTests --silent=true",
        "test:watch": "vitest watch --configLoader=runner",
        "typecheck": "tsgo -p ./tsconfig.json --noEmit true"
    },
    "peerDependencies": {
        "@repo/api-resources": "workspace:*",
        "@gorgias/axiom": "catalog:axiom",
        "@gorgias/design-tokens": "catalog:axiom",
        "@gorgias/events": "catalog:events",
        "@gorgias/helpdesk-queries": "catalog:rest-api-sdk",
        "@gorgias/realtime": "catalog:realtime",
        "@repo/feature-flags": "workspace:*",
        "@repo/forms": "workspace:*",
        "@repo/preferences": "workspace:*",
        "@repo/users": "workspace:*",
        "@repo/utils": "workspace:*",
        "classnames": "catalog:styles",
        "moment": "catalog:moment",
        "react": "catalog:react",
        "react-dom": "catalog:react"
    },
    "devDependencies": {
        "@repo/api-resources": "workspace:*",
        "@gorgias/axiom": "catalog:axiom",
        "@gorgias/design-tokens": "catalog:axiom",
        "@gorgias/helpdesk-mocks": "catalog:rest-api-sdk",
        "@gorgias/helpdesk-queries": "catalog:rest-api-sdk",
        "@gorgias/helpdesk-types": "catalog:rest-api-sdk",
        "@repo/config": "workspace:*",
        "@repo/feature-flags": "workspace:*",
        "@repo/forms": "workspace:*",
        "@repo/testing": "workspace:*",
        "@repo/users": "workspace:*",
        "@repo/utils": "workspace:*",
        "@tanstack/react-query": "catalog:rest-api-sdk",
        "@testing-library/dom": "catalog:test",
        "@testing-library/jest-dom": "catalog:test",
        "@testing-library/react": "catalog:test",
        "@testing-library/user-event": "catalog:test",
        "@types/classnames": "catalog:styles",
        "@types/react": "catalog:react",
        "@types/react-dom": "catalog:react",
        "@vitest/coverage-v8": "catalog:test",
        "classnames": "catalog:styles",
        "moment": "catalog:moment",
        "msw": "catalog:test",
        "oxfmt": "catalog:formatter",
        "oxlint": "catalog:oxlint",
        "react": "catalog:react",
        "react-dom": "catalog:react",
        "typescript": "catalog:typescript",
        "vitest": "catalog:test"
    }
}
