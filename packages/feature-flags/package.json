{
    "name": "@repo/feature-flags",
    "version": "1.0.0",
    "description": "Feature flags package",
    "private": true,
    "exports": {
        ".": "./src/index.ts",
        "./testing": "./src/testing.ts"
    },
    "scripts": {
        "format:check": "prettier --check .",
        "format:fix": "prettier --write .",
        "lint": "oxlint --quiet",
        "lint:unused": "knip --directory ../.. --workspace @repo/feature-flags --no-progress",
        "test": "vitest run --configLoader=runner",
        "test:ci:cover": "vitest run --configLoader=runner --coverage --silent=true",
        "test:watch": "vitest watch --configLoader=runner",
        "typecheck": "tsc -p ./tsconfig.json --noEmit true"
    },
    "peerDependencies": {
        "@gorgias/axiom": "catalog:axiom",
        "@repo/browser-storage": "workspace:*",
        "@repo/hooks": "workspace:*",
        "@repo/utils": "workspace:*",
        "@splitsoftware/splitio-browserjs": "catalog:feature-flags",
        "react": "catalog:react",
        "react-dom": "catalog:react"
    },
    "devDependencies": {
        "@gorgias/axiom": "catalog:axiom",
        "@repo/browser-storage": "workspace:*",
        "@repo/config": "workspace:*",
        "@repo/hooks": "workspace:*",
        "@repo/utils": "workspace:*",
        "@splitsoftware/splitio-browserjs": "catalog:feature-flags",
        "@testing-library/dom": "catalog:test",
        "@testing-library/jest-dom": "catalog:test",
        "@testing-library/react": "catalog:test",
        "@testing-library/user-event": "catalog:test",
        "@trivago/prettier-plugin-sort-imports": "catalog:prettier",
        "@types/react": "catalog:react",
        "@types/react-dom": "catalog:react",
        "@vitest/coverage-v8": "catalog:test",
        "jest-mock": "catalog:test",
        "oxlint": "catalog:oxlint",
        "prettier": "catalog:prettier",
        "react": "catalog:react",
        "react-dom": "catalog:react",
        "typescript": "catalog:typescript",
        "vitest": "catalog:test"
    },
    "dependencies": {
        "@splitsoftware/splitio-react": "^2.6.1",
        "@types/lodash": "^4.17.24",
        "lodash": "4.18.1",
        "zustand": "^5.0.12"
    }
}
