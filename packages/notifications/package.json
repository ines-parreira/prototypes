{
    "name": "@repo/notifications",
    "version": "1.0.0",
    "description": "Notifications panel components",
    "private": true,
    "exports": {
        ".": "./src/index.ts",
        "./components": "./src/components/index.ts"
    },
    "scripts": {
        "format:check": "prettier --check .",
        "format:fix": "prettier --write .",
        "lint": "oxlint --quiet",
        "lint:unused": "knip --directory ../.. --workspace @repo/notifications --no-progress",
        "test": "vitest run --configLoader=runner",
        "test:ci:cover": "NODE_OPTIONS=\"--max-old-space-size=4096\" vitest run --configLoader=runner --coverage --silent=true",
        "test:watch": "vitest watch --configLoader=runner",
        "typecheck": "tsc -p ./tsconfig.json --noEmit true"
    },
    "peerDependencies": {
        "@gorgias/axiom": "catalog:axiom",
        "@knocklabs/client": "^0.16.3",
        "@knocklabs/react": "^0.7.31",
        "react": "catalog:react",
        "react-router-dom": "5.2.0"
    },
    "devDependencies": {
        "@gorgias/axiom": "catalog:axiom",
        "@knocklabs/client": "^0.16.3",
        "@knocklabs/react": "^0.7.31",
        "@repo/config": "workspace:*",
        "@repo/testing": "workspace:*",
        "@types/react-router-dom": "5.3.3",
        "@testing-library/dom": "catalog:test",
        "@testing-library/jest-dom": "catalog:test",
        "@testing-library/react": "catalog:test",
        "@testing-library/user-event": "catalog:test",
        "@trivago/prettier-plugin-sort-imports": "catalog:prettier",
        "@types/react": "catalog:react",
        "@types/react-dom": "catalog:react",
        "@vitest/coverage-v8": "catalog:test",
        "oxlint": "catalog:oxlint",
        "prettier": "catalog:prettier",
        "react": "catalog:react",
        "react-dom": "catalog:react",
        "typescript": "catalog:typescript",
        "vitest": "catalog:test"
    }
}
